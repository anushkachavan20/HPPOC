# Datadog Configuration
DATADOG_API_KEY=your_datadog_api_key_here
DATADOG_APP_KEY=your_datadog_app_key_here
DATADOG_SITE=datadoghq.com
DATADOG_ENVIRONMENT=poc
# Optional: set after the first run to update the same dashboard on later runs
DATADOG_DASHBOARD_ID=

# Ollama Configuration
OLLAMA_API_URL=http://localhost:11434
OLLAMA_MODEL=gemma:7b
OLLAMA_TIMEOUT=60

# Jira Configuration (Real Jira Cloud API)
# Get these from your Jira Cloud instance:
# API URL: https://yourname.atlassian.net (your Jira domain)
# Email: your email address associated with Jira account
# API Token: Create at Atlassian account settings (Settings > API Tokens > Create API Token)
JIRA_API_URL=https://yourname.atlassian.net
JIRA_EMAIL=your-email@example.com
JIRA_API_TOKEN=your_api_token_here
JIRA_PROJECT_KEY=PROJ

# Analysis Configuration
HISTORICAL_LOOKBACK_DAYS=10
# Independent of the Datadog dashboard time selector.
FAILURE_PERSISTENT_THRESHOLD=0.70
FAILURE_FLAKY_MIN_ALTERNATIONS=2
FAILURE_OCCURRENCE_THRESHOLD=3
RESOLUTION_SUCCESS_THRESHOLD=3
AGGREGATION_WINDOW_MINUTES=30
SLOW_RESPONSE_THRESHOLD_MS=1000
DRY_RUN=False

# Logging
LOG_LEVEL=INFO
LOG_FILE=analysis.log

# Environment
ENVIRONMENT=poc
